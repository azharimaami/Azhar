    <style>
        /* ===== NEW ROYAL THEME COLORS ===== */
        :root {
            --royal-blue: #4169E1;
            --hot-pink: #FF1493;
            --gold: #FFD700;
            --soft-lilac: #F5F0FF;
            --dark-navy: #1B1B3A;
            --emerald: #50C878;
            --white: #FFFFFF;
            --shadow: 0 6px 20px rgba(65, 105, 225, 0.12);
            --shadow-hover: 0 10px 30px rgba(65, 105, 225, 0.18);
            --glow: 0 0 25px rgba(255, 20, 147, 0.4);
            --glow-intense: 0 0 40px rgba(255, 20, 147, 0.6);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body {
            font-family: 'Inter', sans-serif;
            background: var(--soft-lilac);
            color: var(--dark-navy);
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* ===== LIGHT EFFECTS CSS ===== */
        @keyframes pulseGlow {
            0% { box-shadow: 0 0 20px rgba(255, 20, 147, 0.4); }
            50% { box-shadow: 0 0 40px rgba(255, 20, 147, 0.8); }
            100% { box-shadow: 0 0 20px rgba(255, 20, 147, 0.4); }
        }
        
        .glow-pulse {
            animation: pulseGlow 2.5s infinite;
            position: relative;
            z-index: 1;
        }
        
        @keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }
        
        .shine-effect {
            position: relative;
            overflow: hidden;
        }
        
        .shine-effect::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                45deg,
                transparent 30%,
                rgba(255, 255, 255, 0.35) 50%,
                transparent 70%
            );
            background-size: 200% 100%;
            animation: shimmer 3s infinite linear;
            z-index: 0;
            transform: rotate(30deg);
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        
        .shine-effect:hover::before {
            opacity: 1;
        }
        
        .glow-border {
            border: 2px solid transparent;
            background: linear-gradient(white, white) padding-box,
                        linear-gradient(135deg, var(--royal-blue), var(--hot-pink)) border-box;
            transition: all 0.4s ease;
        }
        
        .glow-border:hover {
            box-shadow: 0 0 25px rgba(65, 105, 225, 0.4);
            transform: translateY(-3px);
        }
        
        .wa-btn {
            background: linear-gradient(135deg, var(--emerald), #40E0D0);
            color: var(--white);
            padding: 0.85rem 1.8rem;
            border-radius: 50px;
            font-weight: 700;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 8px 20px rgba(80, 200, 120, 0.3);
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            font-size: 1rem;
            white-space: nowrap;
            position: relative;
            overflow: hidden;
        }

        .wa-btn:hover {
            transform: translateY(-3px) scale(1.03);
            box-shadow: var(--glow-intense), 0 15px 30px rgba(80, 200, 120, 0.4);
        }

        .wa-btn:active {
            transform: translateY(0) scale(0.98);
        }
        
        @keyframes buttonShine {
            0% { transform: translateX(-100%) translateY(-100%) rotate(30deg); opacity: 0; }
            50% { opacity: 1; }
            100% { transform: translateX(100%) translateY(100%) rotate(30deg); opacity: 0; }
        }
        
        .wa-btn::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                90deg,
                transparent 0%,
                rgba(255, 255, 255, 0.5) 50%,
                transparent 100%
            );
            transform: rotate(30deg);
            transition: all 0.6s ease;
            z-index: 0;
            opacity: 0;
        }
        
        .wa-btn:hover::after {
            animation: buttonShine 0.8s ease;
        }
        
        .wa-btn > * {
            position: relative;
            z-index: 1;
        }
        
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .animate-fade-in { animation: fadeInUp 0.6s ease-out forwards; opacity: 0; }
        .animate-stagger { animation: fadeInUp 0.6s ease-out forwards; animation-delay: calc(var(--order) * 0.1s); opacity: 0; }

        section { padding: 50px 0; position: relative; }
