        /* ===== WHITE GLITCH EFFECT ===== */
        @keyframes white-glitch {
            0%, 100% { transform: translateX(0) skew(0deg); opacity: 1; }
            10% { transform: translateX(-2px) skew(-1deg); opacity: 0.9; }
            20% { transform: translateX(2px) skew(1deg); opacity: 1; }
            30% { transform: translateX(-1px) skew(0deg); opacity: 0.95; }
            40% { transform: translateX(1px) skew(-0.5deg); opacity: 1; }
            50% { transform: translateX(-3px) skew(0.5deg); opacity: 0.9; }
            60% { transform: translateX(3px) skew(-1deg); opacity: 1; }
        }

        .wa-btn.glitch-effect {
            position: relative;
            overflow: hidden;
        }

        .wa-btn.glitch-effect::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                90deg,
                transparent 0%,
                rgba(255, 255, 255, 0.6) 50%,
                transparent 100%
            );
            transition: left 0.6s;
            z-index: 1;
        }

        .wa-btn.glitch-effect:hover::before {
            left: 100%;
        }

        .wa-btn.glitch-effect:hover {
            animation: white-glitch 0.4s ease-in-out;
        }

        @media (max-width: 768px) {
            section { padding: 40px 0; }
