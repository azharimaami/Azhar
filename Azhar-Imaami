            .wa-btn { width: 100%; justify-content: center; }
            h1.display-3 { font-size: 2rem; }
            h2.display-5 { font-size: 1.5rem; }
        }

        @media (prefers-reduced-motion: reduce) {
            * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
            .shine-effect::before, .wa-btn::after { display: none; }
            .feedback-track { animation: none !important; }
            .wa-btn.glitch-effect:hover { animation: none !important; }
        }
    </style>
